generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GamePlatform {
  PC
  PS5
  PS4
  XBOX_SERIES
  XBOX_ONE
  OTHER
}

enum PreferredRole {
  RUSH
  SUPPORT
  SNIPE
  FLEX
  IGL
  NONE
}

enum WarningType {
  TOXICITY
  ABSENCE
  AFK
  INSULT
  CHEATING_SUSPECT
  TEAM_REFUSAL
  SPAM
  OTHER
}

enum WarningStatus {
  ACTIVE
  REVOKED
}

enum BanSource {
  AUTOMATIC
  MANUAL
}

enum BanStatus {
  ACTIVE
  LIFTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  COMPLETED
  CANCELLED
}

enum EventParticipantStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
  NO_SHOW
}

/**
 * ✅ Composition d'équipe pour un événement, choisie par un admin
 * (indépendant de la réponse du joueur lui-même via EventParticipantStatus).
 */
enum EventRosterRole {
  TITULAIRE
  REMPLACANT
}

enum NotificationType {
  EVENT_PUBLISHED
  EVENT_UPDATED
  EVENT_REMINDER
  WARNING_RECEIVED
  BAN_APPLIED
  BAN_LIFTED
  RULES_UPDATED
  TOURNAMENT_PUBLISHED
  TOURNAMENT_STARTING_SOON
  INFO
}

enum NotificationChannel {
  IN_APP
  DISCORD
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum MixSessionStatus {
  DRAFT
  GENERATED
  PUBLISHED
  ACTIVE
  CLOSED
  CANCELLED
}

enum MixPlayerStatus {
  WAITING
  ASSIGNED
  SKIPPED
  LEFT
}

enum ContactRequestType {
  ADMIN_REQUEST
  PLAYER_REPORT
  BUG
  IMPROVEMENT
  RECRUITMENT
  LEAVE_TEAM
}

enum ContactRequestStatus {
  OPEN
  CLOSED
}

/**
 * ✅ On sépare complètement Warzone normal / Warzone ranked
 * => locks séparés, sessions séparées, temp players séparés.
 */
enum MixGame {
  WARZONE
  WARZONE_RANKED
  BO7
  ROCKET_LEAGUE
  VERSUS
}

/**
 * ✅ Résultat d'une partie renseigné par un admin après coup (facultatif).
 */
enum MatchResult {
  WIN
  LOSS
}

enum RocketLeagueRank {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  CHAMPION
  GRAND_CHAMPION
  SSL
}

enum RocketLeagueTeamSize {
  TWO
  THREE
}

/**
 * ✅ Versus : format choisi par un admin (2v2 / 3v3 / 4v4), comme Rocket League.
 */
enum VersusTeamSize {
  ONE
  TWO
  THREE
  FOUR
}

/**
 * ✅ Warzone Ranked tiers (simple & efficace)
 * (si tu veux plus tard "Bronze I/II/III" etc, on pourra raffiner)
 */
enum WarzoneRankTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  CRIMSON
  IRIDESCENT
  TOP_250
}

/**
 * ✅ Badges
 */
enum BadgeCategory {
  MEMBERSHIP
  SKILL
  ACTIVITY
  BEHAVIOR
  EVENT
  SPECIAL
}

/**
 * ✅ Thème événementiel affiché sur tout le site (réglable dans /admin/settings).
 */
enum SiteTheme {
  DEFAULT
  HALLOWEEN
  CHRISTMAS
}

model SiteConfig {
  id String @id @default("main")

  siteName          String  @default("CHAMA Squad Manager")
  homeHeadline      String  @default("CHAMA Warzone Squad")
  homeDescription   String  @db.Text
  homeHeroImageUrl  String?
  discordInviteUrl  String?
  whatsappInviteUrl String?

  socialsEnabled       Boolean @default(true)
  eventsEnabled        Boolean @default(true)
  contactEnabled       Boolean @default(true)
  registrationsEnabled Boolean @default(true)

  // ✅ Thème événementiel (Halloween, Noël...) affiché sur tout le site.
  theme SiteTheme @default(DEFAULT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String               @id @default(cuid())
  userId    String
  type      ContactRequestType
  subject   String
  message   String               @db.Text
  status    ContactRequestStatus @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  username     String     @unique
  role         UserRole   @default(PLAYER)
  status       UserStatus @default(ACTIVE)

  // ✅ Permissions fines déléguées par un SUPER_ADMIN à un ADMIN (ignoré
  // si role != ADMIN — un SUPER_ADMIN a toujours tout). Le passage
  // admin/retrait admin (toggle-user-role.ts) n'est volontairement PAS
  // déléguable ici : reste SUPER_ADMIN-only en dur, pour éviter qu'un
  // admin puisse créer d'autres admins.
  adminPermissions String[] @default([])

  registrationStatus RegistrationStatus @default(APPROVED)
  approvedAt         DateTime?
  approvedById       String?
  rejectedAt         DateTime?
  rejectedById       String?

  // ✅ Renseigné librement par le joueur à l'inscription : pseudo/nom du
  // membre qui l'a invité, pour que les admins sachent qui a fait venir qui.
  // Texte libre (pas de FK vers un autre User) : le joueur ne connaît pas
  // forcément le pseudo exact ni même si la personne a un compte.
  invitedByName String?

  warzoneUsername String
  activisionId    String?
  platform        GamePlatform?
  preferredRole   PreferredRole @default(NONE)

  discordUsername String?
  discordUserId   String? @unique
  whatsappNumber  String?
  whatsappOptIn   Boolean @default(false)

  // ✅ Twitch (pseudo de chaîne, sans le "https://twitch.tv/")
  twitchUsername String?

  micAvailable  Boolean @default(true)
  notes         String?
  isChamaMember Boolean @default(false)

  // ✅ Appartenance à la team partenaire AURA (affichage/tag uniquement,
  // pour différencier visuellement les joueurs de chaque team côté admin —
  // pas de pop-up de bienvenue dédié, contrairement à isChamaMember).
  isAuraMember Boolean @default(false)

  // ✅ Pop-up de bienvenue "membre CHAMA" : null => pas encore vu, réinitialisé
  // à chaque fois qu'un admin active le statut membre.
  chamaWelcomeSeenAt DateTime?

  // ✅ Pop-up de félicitations à la 1ère connexion après validation de
  // l'inscription : null => pas encore vu. Backfillée à `now()` pour les
  // comptes déjà APPROVED au moment de l'ajout de ce champ (voir migration).
  approvalWelcomeSeenAt DateTime?

  // Rocket League
  rocketLeagueRank RocketLeagueRank?

  // ✅ Warzone Ranked
  warzoneRankTier WarzoneRankTier?
  warzoneRankSr   Int?

  isOnline Boolean @default(false)

  // ancien flag global (compat)
  isAvailableForMix Boolean @default(false)

  // flags par jeu
  isAvailableForWarzoneMix       Boolean @default(false)
  isAvailableForWarzoneRankedMix Boolean @default(false)
  isAvailableForBO7Mix           Boolean @default(false)
  isAvailableForRocketLeagueMix  Boolean @default(false)
  isAvailableForVersusMix        Boolean @default(false)

  lastSeenAt  DateTime?
  lastLoginAt DateTime?

  // Verrouillage anti brute-force
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  acceptedRulesAt        DateTime?
  acceptedRulesVersionId String?
  acceptedRulesVersion   RulesVersion? @relation("AcceptedRulesVersion", fields: [acceptedRulesVersionId], references: [id], onDelete: SetNull)

  bannedAt       DateTime?
  banReason      String?
  banTriggerType WarningType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedBy    User?  @relation("ApprovedUsers", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("ApprovedUsers")

  rejectedBy    User?  @relation("RejectedUsers", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedUsers User[] @relation("RejectedUsers")

  warningsReceived      Warning[]          @relation("WarningsReceived")
  warningsIssued        Warning[]          @relation("WarningsIssued")
  bansReceived          Ban[]              @relation("BansReceived")
  bansIssued            Ban[]              @relation("BansIssued")
  newsCreated           News[]
  eventsCreated         Event[]
  rulesVersionsAuthored RulesVersion[]     @relation("RulesVersionAuthor")
  notifications         Notification[]
  eventParticipations   EventParticipant[]
  mixEntries            MixSessionPlayer[]
  teamMemberships       TeamMember[]
  mixSessions           MixSession[]
  contactRequests       ContactRequest[]

  roleChangesReceived RoleChangeLog[] @relation("RoleChangesTargetUser")
  roleChangesIssued   RoleChangeLog[] @relation("RoleChangesAdminUser")

  tempPlayersCreated TempPlayer[] @relation("CreatedTempPlayers")
  tempPlayersLinked  TempPlayer[] @relation("LinkedTempPlayers")

  mixLocksSelected MixGenerationLock[] @relation("MixGenerationLockSelectedUser")

  // ✅ Badges attribués au joueur
  badges UserBadge[]

  // ✅ Journal d'activité (super admin)
  activityLogsAsActor  ActivityLog[] @relation("ActivityLogActor")
  activityLogsAsTarget ActivityLog[] @relation("ActivityLogTarget")

  // ✅ Système de points
  scoreBoardsCreated          ScoreBoard[]              @relation("ScoreBoardsCreated")
  scoreTeamMemberships        ScoreTeamMember[]         @relation("ScoreTeamMemberships")
  scoreTournamentsCreated     ScoreTournament[]         @relation("ScoreTournamentsCreated")
  scoreBracketTeamMemberships ScoreBracketTeamMember[]  @relation("ScoreBracketTeamMemberships")
  scoreTournamentInterests    ScoreTournamentInterest[] @relation("ScoreTournamentInterests")

  // ✅ Notifications push (navigateur/PWA)
  pushSubscriptions PushSubscription[]

  @@index([registrationStatus])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([isAvailableForWarzoneMix])
  @@index([isAvailableForWarzoneRankedMix])
  @@index([isAvailableForBO7Mix])
  @@index([isAvailableForRocketLeagueMix])
  @@index([isAvailableForVersusMix])
  @@index([rocketLeagueRank])
  @@index([warzoneRankTier])
  @@index([twitchUsername])
}

model TempPlayer {
  id       String  @id @default(cuid())
  nickname String
  note     String? @db.Text

  // ✅ Le jeu auquel appartient l'invité
  game MixGame @default(WARZONE)

  // ✅ dispo dans la file du jeu
  isAvailableForMix Boolean @default(true)

  // ✅ pour Rocket League : rang si tu veux l’utiliser dans les teams RL
  rocketLeagueRank RocketLeagueRank?

  // (Optionnel futur) si tu veux autoriser invités en ranked :
  // warzoneRankTier WarzoneRankTier?
  // warzoneRankSr   Int?

  createdById String?
  createdBy   User?   @relation("CreatedTempPlayers", fields: [createdById], references: [id], onDelete: SetNull)

  linkedUserId String?
  linkedUser   User?   @relation("LinkedTempPlayers", fields: [linkedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mixEntries      MixSessionPlayer[]
  teamMemberships TeamMember[]

  @@index([game])
  @@index([isAvailableForMix])
  @@index([createdById])
  @@index([linkedUserId])
  @@index([createdAt])
}

model RulesVersion {
  id            String    @id @default(cuid())
  versionNumber Int       @unique
  title         String
  content       String    @db.Text
  isActive      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  updatedById String?
  updatedBy   User?   @relation("RulesVersionAuthor", fields: [updatedById], references: [id], onDelete: SetNull)

  acceptedByUsers User[] @relation("AcceptedRulesVersion")

  @@index([isActive])
  @@index([isPublished])
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String    @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isPublished])
  @@index([publishedAt])
}

model Event {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String      @db.Text
  eventDate     DateTime
  endDate       DateTime?
  status        EventStatus @default(DRAFT)
  coverImageUrl String?

  publishToDiscord  Boolean @default(true)
  publishToWhatsApp Boolean @default(false)
  publishInApp      Boolean @default(true)

  discordMessageId     String?
  whatsappBroadcastRef String?

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  participants  EventParticipant[]
  notifications Notification[]

  @@index([eventDate])
  @@index([status])
  @@index([isPublished])
}

model EventParticipant {
  id         String                 @id @default(cuid())
  eventId    String
  userId     String
  status     EventParticipantStatus @default(REGISTERED)
  rosterRole EventRosterRole?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model Warning {
  id           String        @id @default(cuid())
  targetUserId String
  adminUserId  String
  type         WarningType
  message      String        @db.Text
  status       WarningStatus @default(ACTIVE)

  revokedAt        DateTime?
  revokedReason    String?   @db.Text
  revokedByAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetUser User @relation("WarningsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminUser  User @relation("WarningsIssued", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId])
  @@index([adminUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Ban {
  id           String    @id @default(cuid())
  targetUserId String
  adminUserId  String?
  source       BanSource
  status       BanStatus @default(ACTIVE)

  reason           String       @db.Text
  triggerType      WarningType?
  triggeredByCount Int?

  startedAt  DateTime  @default(now())
  liftedAt   DateTime?
  liftReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetUser User  @relation("BansReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminUser  User? @relation("BansIssued", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([adminUserId])
  @@index([status])
  @@index([source])
}

model Notification {
  id      String  @id @default(cuid())
  userId  String
  eventId String?

  type    NotificationType
  channel NotificationChannel @default(IN_APP)
  status  NotificationStatus  @default(PENDING)

  title   String
  message String @db.Text

  sentAt      DateTime?
  readAt      DateTime?
  externalRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

// Abonnement Web Push d'un navigateur (un par appareil/navigateur installé,
// pas par utilisateur — quelqu'un connecté sur téléphone + PC a 2 lignes).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MixSession {
  id     String           @id @default(cuid())
  title  String?
  status MixSessionStatus @default(DRAFT)

  game MixGame @default(WARZONE)

  // Rocket League : stocke le format réellement généré (2v2/3v3)
  rocketLeagueTeamSize RocketLeagueTeamSize?

  allowTeamsOfThree    Boolean @default(false)
  keepRemainderAsBench Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  players MixSessionPlayer[]
  teams   Team[]

  @@index([status])
  @@index([createdAt])
  @@index([game])
}

model MixSessionPlayer {
  id           String          @id @default(cuid())
  sessionId    String
  userId       String?
  tempPlayerId String?
  status       MixPlayerStatus @default(WAITING)
  joinedAt     DateTime        @default(now())
  assignedAt   DateTime?

  session    MixSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tempPlayer TempPlayer? @relation(fields: [tempPlayerId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@unique([sessionId, tempPlayerId])
  @@index([sessionId])
  @@index([userId])
  @@index([tempPlayerId])
  @@index([status])
}

model Team {
  id         String   @id @default(cuid())
  sessionId  String
  teamNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // ✅ Résultat renseigné après coup par un admin (victoire/défaite), sert
  // au classement des joueurs. null = non renseigné.
  result MatchResult?

  session MixSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([sessionId, teamNumber])
  @@index([sessionId])
  @@index([result])
}

model TeamMember {
  id           String   @id @default(cuid())
  teamId       String
  userId       String?
  tempPlayerId String?
  addedAt      DateTime @default(now())

  // ✅ Hôte de la partie (celui que le reste de l'équipe rejoint), désigné
  // automatiquement à la génération du mix. Affiché avec une couronne.
  isHost Boolean @default(false)

  // ✅ Stats facultatives auto-déclarées par les joueurs eux-mêmes
  // (n'importe quel membre de l'équipe peut les renseigner, pour
  // lui-même ou pour un coéquipier). Sert au classement K/D.
  kills  Int?
  deaths Int?

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tempPlayer TempPlayer? @relation(fields: [tempPlayerId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([teamId, tempPlayerId])
  @@index([teamId])
  @@index([userId])
  @@index([tempPlayerId])
}

model RoleChangeLog {
  id           String @id @default(cuid())
  targetUserId String
  adminUserId  String

  previousRole UserRole
  nextRole     UserRole

  createdAt DateTime @default(now())

  targetUser User @relation("RoleChangesTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  adminUser  User @relation("RoleChangesAdminUser", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([createdAt])
}

model MixGenerationLock {
  game           MixGame @id
  selectedUserId String?

  // Rocket League : format autorisé (2v2/3v3) pour la génération
  rocketLeagueTeamSize RocketLeagueTeamSize?

  // Versus : format choisi (2v2/3v3/4v4) pour la génération
  versusTeamSize VersusTeamSize?

  updatedAt DateTime @default(now()) @updatedAt

  selectedUser User? @relation("MixGenerationLockSelectedUser", fields: [selectedUserId], references: [id], onDelete: SetNull)

  @@index([selectedUserId])
}

/**
 * ✅ Salon vocal Discord associé à un numéro d'équipe pour un jeu donné.
 * Utilisé pour déplacer automatiquement les joueurs (comptes Discord liés
 * via OAuth) dans le bon vocal à la génération d'un mix. L'ordre de
 * création détermine le numéro d'équipe (1er créé = équipe 1, etc).
 */
model DiscordVoiceChannel {
  id        String   @id @default(cuid())
  game      MixGame
  label     String
  channelId String
  createdAt DateTime @default(now())

  @@index([game, createdAt])
}

/**
 * ===========================
 * ✅ BADGES
 * ===========================
 */

model Badge {
  id          String        @id @default(cuid())
  code        String        @unique // ex: CHAMA_MEMBER, TOP_FRAGGER
  name        String
  description String        @db.Text
  category    BadgeCategory
  icon        String? // mapping UI (ex: "chama", "trophy", "shield")
  color       String? // mapping UI (ex: "cyan", "pink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserBadge[]

  @@index([category])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  note     String?  @db.Text

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([earnedAt])
}

/**
 * ✅ Monitoring d'erreurs auto-hébergé : chaque erreur inattendue capturée
 * côté serveur (server actions, routes API) est journalisée ici plutôt que
 * de finir uniquement dans les logs pm2. Consultable depuis /admin/errors.
 * Pas de FK vers User (une erreur doit survivre à la suppression du compte
 * qui l'a déclenchée).
 */
model ErrorLog {
  id      String  @id @default(cuid())
  context String // ex: GENERATE_MIX_ERROR
  message String  @db.Text
  stack   String? @db.Text
  userId  String?
  url     String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([context])
}

/**
 * ✅ Journal d'activité (super admin uniquement, /admin/activity) : trace
 * "qui a fait quoi" sur le site (inscriptions, passages admin, CHAMA/AURA,
 * mix générés, bannissements, badges...). actorId/targetId en SetNull +
 * labels en snapshot texte : le journal reste lisible même après
 * suppression d'un compte (voir deletePlayer).
 */
enum ActivityAction {
  REGISTRATION_CREATED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  ROLE_CHANGED
  ADMIN_PERMISSIONS_UPDATED
  CHAMA_TOGGLED
  AURA_TOGGLED
  PLAYER_BANNED
  PLAYER_UNBANNED
  PLAYER_DELETED
  PASSWORD_RESET
  WARNING_ADDED
  WARNING_REVOKED
  BADGE_CREATED
  BADGE_DELETED
  BADGE_AWARDED
  BADGE_REVOKED
  DISCORD_CHANNEL_CREATED
  DISCORD_CHANNEL_UPDATED
  DISCORD_CHANNEL_DELETED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  EVENT_ROSTER_UPDATED
  CONTACT_CLOSED
  SITE_CONFIG_UPDATED
  MIX_GENERATED
  SCORE_GAME_MODE_CREATED
  SCORE_GAME_MODE_DELETED
  SCORE_CONDITION_CREATED
  SCORE_CONDITION_DELETED
  SCORE_BOARD_CREATED
  SCORE_ENTRY_UPDATED
  SCORE_TIER_CREATED
  SCORE_TIER_DELETED
  SCORE_TOURNAMENT_CREATED
  SCORE_TOURNAMENT_DELETED
  SCORE_BOARD_TOURNAMENT_SET
  SCORE_CONDITION_UPDATED
  SCORE_BOARD_DELETED
  SCORE_TEAM_DELETED
  SCORE_TEAM_MEMBER_REMOVED
  SCORE_TOURNAMENT_STARTED
  SCORE_TEAM_JOINED
  SCORE_TEAM_LEFT
  SCORE_TEAMS_RANDOMIZED
  SCORE_BRACKET_TEAM_ADDED
  SCORE_MATCH_WINNER_SET
  SCORE_BRACKET_ROUND_ADVANCED
  SCORE_BRACKET_TEAM_MEMBER_ADDED
  SCORE_BRACKET_TEAM_MEMBER_REMOVED
  SCORE_TOURNAMENT_INTEREST_JOINED
  SCORE_TOURNAMENT_INTEREST_LEFT
  SCORE_BOARD_FINISHED
  SCORE_BOARD_REOPENED
  SCORE_TEAM_MEMBER_REPLACED
  MONTHLY_RANKING_ARCHIVED
}

model ActivityLog {
  id     String         @id @default(cuid())
  action ActivityAction

  actorId     String?
  actorLabel  String // snapshot "Nom (@pseudo)" au moment de l'action
  targetId    String?
  targetLabel String? // snapshot de la cible (joueur, event, badge...)

  metadata Json? // détails libres (ex: { "game": "VERSUS", "sessionId": "..." })

  createdAt DateTime @default(now())

  actor  User? @relation("ActivityLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("ActivityLogTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([createdAt])
  @@index([actorId])
  @@index([targetId])
}

/**
 * ===========================
 * ✅ SYSTÈME DE POINTS (classement configurable par mode de jeu)
 * ===========================
 */

enum ScoreConditionMode {
  QUANTITY // l'admin saisit un nombre, points = nombre × condition.points
  ONE_TIME // atteinte ou pas (case à cocher), points = condition.points si cochée
  TIERED // l'admin saisit un nombre, points = ceux du palier (tranche) dans lequel il tombe
}

enum ScoreConditionTarget {
  TEAM // condition appliquée à l'équipe entière (ex: Victoire)
  PLAYER // condition appliquée à un membre précis (ex: Kill, MVP)
}

model ScoreGameMode {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conditions  ScoreCondition[]
  boards      ScoreBoard[]
  tournaments ScoreTournament[] @relation("ScoreTournamentGameModes")

  @@index([isActive])
}

model ScoreCondition {
  id         String               @id @default(cuid())
  gameModeId String
  label      String
  points     Int // ignoré si mode == TIERED (les points viennent des paliers)
  mode       ScoreConditionMode   @default(ONE_TIME)
  appliesTo  ScoreConditionTarget @default(PLAYER)
  createdAt  DateTime             @default(now())

  gameMode ScoreGameMode        @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
  entries  ScoreEntry[]
  tiers    ScoreConditionTier[]

  @@index([gameModeId])
}

/**
 * Tranche de valeurs pour une condition TIERED, ex: "entre 5 et 9 kills =
 * 10 pts". maxValue à null => tranche illimitée vers le haut ("10+"). Les
 * points peuvent être négatifs (ex: pénalité de morts).
 */
model ScoreConditionTier {
  id          String @id @default(cuid())
  conditionId String
  minValue    Int
  maxValue    Int?
  points      Int

  condition ScoreCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@index([conditionId])
}

model ScoreBoard {
  id           String    @id @default(cuid())
  gameModeId   String
  title        String?
  createdAt    DateTime  @default(now())
  createdById  String?
  tournamentId String? // partie rattachée à un tournoi (facultatif)
  // Une fois définie : scores/équipes verrouillés (lecture seule) — bouton
  // "Modifier les scores" pour la remettre à null et déverrouiller. Sert
  // aussi de porte pour la partie suivante du tournoi (créable une fois
  // celle-ci terminée).
  finishedAt   DateTime?

  gameMode   ScoreGameMode    @relation(fields: [gameModeId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation("ScoreBoardsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  tournament ScoreTournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  teams      ScoreTeam[]

  // Une seule partie par mode dans un même tournoi (les tableaux hors
  // tournoi, tournamentId = NULL, ne sont pas concernés par la contrainte :
  // Postgres traite chaque NULL comme distinct).
  @@unique([tournamentId, gameModeId])
  @@index([gameModeId, createdAt])
  @@index([tournamentId])
}

/**
 * Regroupe plusieurs tableaux (même mode de jeu ou modes différents,
 * ex: 3 parties Warzone/Rocket League/BO7 dans une même soirée) pour en
 * cumuler les points par équipe et désigner un vainqueur global. Les
 * équipes sont réconciliées entre tableaux par leur nom (comme les
 * joueurs invités sont réconciliés entre tableaux par leur nom) : pas de
 * roster persistant, juste une convention de nommage cohérente d'une
 * partie à l'autre.
 */
enum ScoreTournamentTeamMode {
  MANUAL // l'admin crée les équipes/joueurs à la main sur chaque partie (défaut, comportement historique)
  SELF_JOIN // les joueurs choisissent eux-mêmes leur équipe depuis /points
  RANDOM // l'admin tire les équipes au sort à partir d'un pool choisi
}

enum ScoreTournamentFormat {
  CLASSIC // cumul de points sur une partie par mode de jeu (comportement historique)
  BRACKET // élimination directe : équipes appariées, le vainqueur avance
}

model ScoreTournament {
  id          String                @id @default(cuid())
  name        String
  description String?               @db.Text
  createdAt   DateTime              @default(now())
  createdById String?
  format      ScoreTournamentFormat @default(CLASSIC)
  // Date à laquelle le tournoi doit se dérouler (facultative, distincte de
  // createdAt qui reflète juste le moment où l'admin l'a configuré dans le site).
  scheduledAt DateTime?
  // Horodatage du rappel "le tournoi commence bientôt" (push), pour ne
  // l'envoyer qu'une seule fois même si le job de vérification tourne
  // plusieurs fois avant le début du tournoi.
  startingSoonNotifiedAt DateTime?

  // Nombre d'équipes / taille max souhaités (optionnels : laissés vides,
  // tout reste manuel comme avant). Utilisés pour auto-créer les équipes
  // à la 1ère partie et pour les modes SELF_JOIN/RANDOM (format CLASSIC
  // uniquement — un bracket gère ses équipes séparément, voir
  // ScoreBracketTeam).
  teamCount         Int?
  maxMembersPerTeam Int?
  teamMode          ScoreTournamentTeamMode @default(MANUAL)
  // Une fois définie : format CLASSIC => plus aucun changement de
  // composition d'équipe par les joueurs (SELF_JOIN) ni de nouveau tirage
  // au sort (RANDOM) ; format BRACKET => le 1er tour est généré à partir
  // des équipes déclarées et la liste des équipes est verrouillée.
  startedAt         DateTime?

  createdBy    User?                     @relation("ScoreTournamentsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  // Modes de jeu retenus pour ce tournoi (choisis à la création) : le
  // site sait ainsi d'avance combien de parties composent le tournoi et
  // pour quels modes, sans attendre que des tableaux soient créés.
  // Optionnel pour un tournoi BRACKET (informatif seulement, aucun
  // tableau n'est créé pour ce format).
  gameModes    ScoreGameMode[]           @relation("ScoreTournamentGameModes")
  boards       ScoreBoard[]
  bracketTeams ScoreBracketTeam[]
  matches      ScoreMatch[]
  interests    ScoreTournamentInterest[]

  @@index([createdAt])
}

/**
 * Sondage de participation : un joueur indique vouloir participer à un
 * tournoi avant même que les équipes existent — utilisé pour pré-remplir
 * le pool du tirage au sort (comme la queue des mix Warzone/BO7/...),
 * sans que l'admin ait à sélectionner manuellement tout le monde. Fermé
 * dès que le tournoi a démarré.
 */
model ScoreTournamentInterest {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())

  tournament ScoreTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User            @relation("ScoreTournamentInterests", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId])
}

/**
 * Équipe déclarée pour un tournoi en format BRACKET — juste un nom,
 * indépendant du système ScoreTeam/ScoreTeamMember (qui suit des joueurs
 * précis pour le calcul de points, inutile pour un simple gagnant/perdant).
 */
model ScoreBracketTeam {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  createdAt    DateTime @default(now())

  tournament ScoreTournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members    ScoreBracketTeamMember[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
}

/**
 * Joueur (inscrit ou invité) affecté à une équipe de bracket — purement
 * informatif : les matchs référencent l'équipe par son nom, pas par ses
 * membres (aucun calcul de points individuel n'a de sens pour un simple
 * gagnant/perdant).
 */
model ScoreBracketTeamMember {
  id            String  @id @default(cuid())
  bracketTeamId String
  userId        String?
  guestName     String?

  bracketTeam ScoreBracketTeam @relation(fields: [bracketTeamId], references: [id], onDelete: Cascade)
  user        User?            @relation("ScoreBracketTeamMemberships", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([bracketTeamId, userId])
  @@index([bracketTeamId])
  @@index([userId])
}

/**
 * Un match d'un bracket à élimination directe. `teamBName` null = "bye"
 * (équipe qualifiée d'office, pas d'adversaire ce tour). Les équipes sont
 * référencées par leur nom (comme partout ailleurs dans le système de
 * points), pas par une relation stricte.
 */
enum ScoreMatchBracketType {
  WINNERS // bracket principal : une défaite = descente en LOSERS
  LOSERS // bracket des perdants : une défaite ici = élimination définitive
  GRAND_FINAL // vainqueur WINNERS vs vainqueur LOSERS, désigne le champion
}

model ScoreMatch {
  id           String                @id @default(cuid())
  tournamentId String
  bracketType  ScoreMatchBracketType @default(WINNERS)
  round        Int
  position     Int
  teamAName    String?
  teamBName    String?
  winnerName   String?
  // Le perdant de ce match a-t-il déjà été inséré dans le bracket LOSERS ?
  // Évite de le réinjecter plusieurs fois si "Générer le tour suivant"
  // est déclenché plusieurs fois pendant que l'autre bracket rattrape son
  // retard. Non pertinent (toujours false) pour LOSERS/GRAND_FINAL.
  lbSeeded     Boolean               @default(false)
  createdAt    DateTime              @default(now())

  tournament ScoreTournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, bracketType, round, position])
  @@index([tournamentId, bracketType, round])
}

model ScoreTeam {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  createdAt DateTime @default(now())

  board   ScoreBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  members ScoreTeamMember[]
  entries ScoreEntry[]

  @@index([boardId])
}

model ScoreTeamMember {
  id        String  @id @default(cuid())
  teamId    String
  userId    String?
  guestName String?

  team    ScoreTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User?        @relation("ScoreTeamMemberships", fields: [userId], references: [id], onDelete: SetNull)
  entries ScoreEntry[]

  // Un même joueur inscrit ne peut apparaître qu'une fois dans une équipe
  // donnée (les invités, userId = NULL, ne sont pas concernés par cette
  // contrainte — Postgres traite chaque NULL comme distinct).
  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model ScoreEntry {
  id           String   @id @default(cuid())
  conditionId  String
  teamId       String?
  teamMemberId String?
  quantity     Int      @default(1)
  createdAt    DateTime @default(now())

  condition  ScoreCondition   @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  team       ScoreTeam?       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamMember ScoreTeamMember? @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([conditionId, teamId])
  @@unique([conditionId, teamMemberId])
  @@index([conditionId])
}
