# Copier ce fichier en .env et remplir les vraies valeurs.
# Ne JAMAIS committer le fichier .env réel (déjà exclu par .gitignore).

# Généré avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Une valeur différente doit être utilisée par environnement (dev / prod).
NEXTAUTH_SECRET="remplacer-par-une-valeur-aleatoire-64-caracteres"

# URL publique du site (sans slash final).
NEXTAUTH_URL="https://chama-gaming.site"

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"

# Optionnel : détection automatique des lives Twitch (page /lives).
# Créer une app sur https://dev.twitch.tv/console/apps puis coller ses
# identifiants ici. Sans ces deux valeurs, la page /lives fonctionne quand
# même (liste des chaînes), juste sans badge "EN LIVE" automatique.
TWITCH_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWITCH_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optionnel : connexion Discord des joueurs (profil) + déplacement
# automatique en vocal à la génération d'un mix (voir /admin/discord).
# Créer une app sur https://discord.com/developers/applications.
# OAuth2 (onglet "OAuth2") : CLIENT_ID / CLIENT_SECRET, redirect URI à
# ajouter = NEXTAUTH_URL + /api/discord/callback.
DISCORD_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
DISCORD_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Bot (onglet "Bot") : token du bot, invité sur le serveur avec la
# permission "Move Members". GUILD_ID = ID du serveur Discord (clic
# droit sur le serveur, mode développeur activé -> Copier l'ID).
DISCORD_BOT_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DISCORD_GUILD_ID="xxxxxxxxxxxxxxxxxx"

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chama"

# Notifications push (navigateur/PWA) : notification "logo de l'app" +
# alerte quand un tournoi/événement est publié, ou qu'un tournoi démarre
# bientôt. Générer une paire de clés avec :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY doit avoir EXACTEMENT la même valeur que
# VAPID_PUBLIC_KEY (le préfixe NEXT_PUBLIC_ l'expose au navigateur, requis
# pour s'abonner). Sans ces variables, le site fonctionne normalement,
# juste sans notifications push (le bouton "Activer" du profil reste masqué).
VAPID_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:contact@chama-gaming.site"

# Optionnel : le rappel "le tournoi commence bientôt" tourne déjà tout
# seul (voir src/instrumentation.ts, toutes les 5 min) — pas besoin de
# cette variable pour ça. Elle protège juste une route de déclenchement
# manuel (GET /api/cron/tournament-reminders?secret=...) utile pour
# forcer une vérification immédiate. Sans cette variable, la route répond
# 501 sans rien casser d'autre.
CRON_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
