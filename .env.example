# Copier ce fichier en .env et remplir les vraies valeurs.
# Ne JAMAIS committer le fichier .env réel (déjà exclu par .gitignore).

# Généré avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Une valeur différente doit être utilisée par environnement (dev / prod).
NEXTAUTH_SECRET="remplacer-par-une-valeur-aleatoire-64-caracteres"

# URL publique du site (sans slash final).
NEXTAUTH_URL="https://chama-gaming.site"

DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxx/yyy"

TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxx"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chama"
